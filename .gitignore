# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.vercel/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# extra: exclude local scripts and tests from repo
scripts/**
*.test.*
*test*.js
*test*.ts
simple-test.js
server.js

# ...but the inventory regression suite and the reconciliation script are
# deliverables the team has to be able to run, so they belong in the repo.
!__tests__/**
!scripts/reconcile-stock.js
!scripts/sync-indexes.js

# rendered email previews (npm run email:preview)
.email-preview/
